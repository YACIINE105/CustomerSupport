# Local development defaults; use separate credentials for deployed environments.
APP_NAME="Customer Support Platform"
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/customer_support

# Generate a random secret: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=customer-support
JWT_AUDIENCE=customer-support-api
